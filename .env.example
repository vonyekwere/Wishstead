NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=secret-key

# Enable CAPTCHA in Supabase Auth and provide its provider secret in the
# Supabase dashboard (hosted) or supabase/config.toml (local). API requests then
# pass the provider-issued token as captchaToken.

