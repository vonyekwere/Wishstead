WISHSTEAD_TEST_VENDOR_NAME=
WISHSTEAD_TEST_VENDOR_PASSWORD=

WISHSTEAD_TEST_ADMIN_EMAIL=
WISHSTEAD_TEST_ADMIN_NAME=
WISHSTEAD_TEST_ADMIN_PASSWORD=

WISHSTEAD_TEST_SUPER_ADMIN_EMAIL=
